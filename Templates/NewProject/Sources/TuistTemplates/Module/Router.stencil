import SwiftUI
import Common

@MainActor
public class {{ name }}Router {
    public init(){}

    public func initView() -> some View {
        let vm = {{ name }}DI.shared.resolve({{ name }}ViewModel.self)

        return {{ name }}RootView(
            viewModel: vm
        )
    }
}

@MainActor
@ViewBuilder
public func {{ name|lowercase }}Destination(for route: AppRoute) -> some View {
    switch route {
    // case .someRoute:
    //     // TODO: SomeRouter(nav: nav).initView()
    //     Text("Some Route")
    default:
        {{ name|lowercase }}DefaultDestination(for: route)
    }
}

@MainActor
@ViewBuilder
private func {{ name|lowercase }}DefaultDestination(for route: AppRoute) -> some View {
    if route.isParamsRoute {
        {{ name|lowercase }}ParamsRouteDestination(for: route.rawValue)
    } else {
        // Fallback an toàn nếu có route rác
        Text("Màn hình không tồn tại")
    }
}

@MainActor
@ViewBuilder
private func {{ name|lowercase }}ParamsRouteDestination(for path: String) -> some View {
    if let route = decodeRouteQueryParams(path),
       route.path == "{{ name|lowercase }}", route.function == "example_function",
       let someParam = route.param("param_name") {
        // TODO: ExampleRouter(param: someParam, nav: nav).initView()
        Text("Example Function: \(someParam)")
    } else {
        Text("Lỗi: Không đúng định dạng URL")
    }
}
